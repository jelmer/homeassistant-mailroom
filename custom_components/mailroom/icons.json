{
  "entity": {
    "event": {
      "parcel": {
        "default": "mdi:package-variant"
      }
    },
    "sensor": {
      "in_transit": {
        "default": "mdi:truck-fast"
      },
      "out_for_delivery": {
        "default": "mdi:truck-delivery"
      },
      "arriving_today": {
        "default": "mdi:calendar-today"
      },
      "overdue": {
        "default": "mdi:clock-alert-outline"
      },
      "problem": {
        "default": "mdi:alert-circle-outline"
      },
      "delivered": {
        "default": "mdi:package-variant-closed-check"
      },
      "total": {
        "default": "mdi:package-variant-closed"
      }
    }
  },
  "services": {
    "add_parcel": {
      "service": "mdi:package-variant-closed-plus"
    },
    "refresh_parcel": {
      "service": "mdi:refresh"
    },
    "remove_parcel": {
      "service": "mdi:package-variant-closed-remove"
    }
  }
}
